{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-harness/config.schema.json",
  "title": "harness.json (family config format, version 3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checks", "policy", "compose"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 3 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "timeout_seconds": { "type": "integer", "minimum": 1, "default": 600 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": { "type": "integer", "minimum": 1, "default": 3 },
        "agent_seconds": { "type": "integer", "minimum": 1, "default": 1200 },
        "run_seconds": { "type": "integer", "minimum": 1, "default": 5400 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editable_paths", "protected_paths"],
      "properties": {
        "editable_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "protected_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "services", "test_service"],
      "properties": {
        "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "services": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$" } },
        "test_service": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
